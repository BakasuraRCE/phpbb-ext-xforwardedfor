{
	"name": "bakasura/xforwardedfor",
	"type": "phpbb-extension",
	"description": "X-Forwarded-For Extension for phpBB 3.3",
	"homepage": "https://github.com/BakasuraRCE/phpbb-ext-xforwardedfor",
	"version": "1.1.0",
	"keywords": ["phpbb", "extension", "trusted ip", "ip", "x-forwarded-for", "session", "cloudflare", "security"],
	"license": "GPL-2.0-only",
	"authors": [
		{
			"name": "Bakasura",
			"homepage": "https://bakasurarce.github.io/",
			"role": "Developer"
		}
	],
	"require": {
		"php": ">=7.1.3",
		"composer/installers": "~1.0"
	},
	"support": {
		"issues": "https://github.com/BakasuraRCE/phpbb-ext-xforwardedfor/issues",
		"source": "https://github.com/BakasuraRCE/phpbb-ext-xforwardedfor"
	},
	"extra": {
		"display-name": "X-Forwarded-For",
		"soft-require": {
			"phpbb/phpbb": ">=3.3.0,<4.0.0@dev"
		},
		"version-check": {
			"host": "raw.githubusercontent.com",
			"directory": "/BakasuraRCE/phpbb-ext-xforwardedfor/main",
			"filename": "version_check.json"
		}
	}
}
